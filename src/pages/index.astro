---
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/schibsted-grotesk/800.css';
import '@fontsource/gloock/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/gulzar/arabic-400.css';
import headlineFont from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-800-normal.woff2?url';

const EMAIL = 'mirhusainalimohammed@gmail.com';
const mailto = `mailto:${EMAIL}`;
const site = Astro.site?.href ?? 'https://mirhusainali.com/';
const name = 'Mir Husain Ali';
const title = 'Mir Husain Ali | Dynamics 365 CE & Data Migration Engineer';
const description = 'Mir Husain Ali, Dynamics 365 CE and data migration engineer at Async Solution. Moved 3.9M+ records across four orgs. Builds valet, Kanz e Aza and Kanz Studio.';
const image = new URL('og.png', site).href;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': site + '#website',
      url: site,
      name,
      alternateName: ['Mir Husain Ali Mohammed', 'mirhusainali.com'],
      inLanguage: 'en',
    },
    {
      '@type': 'ProfilePage',
      '@id': site + '#profile',
      url: site,
      name: title,
      description,
      isPartOf: { '@id': site + '#website' },
      mainEntity: { '@id': site + '#person' },
      primaryImageOfPage: image,
      inLanguage: 'en',
    },
    {
      '@type': 'Person',
      '@id': site + '#person',
      name,
      alternateName: ['Mir Husain Ali Mohammed', 'Mir Hussain Ali'],
      url: site,
      image,
      email: 'mailto:mirhusainalimohammed@gmail.com',
      jobTitle: 'Dynamics 365 CE & Data Migration Engineer',
      description,
      worksFor: { '@type': 'Organization', name: 'Async Solution' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Amity University' },
      knowsAbout: [
        'Microsoft Dynamics 365 Customer Engagement', 'Data migration',
        '.NET', 'DevOps', 'Rust', 'Flutter', 'Self-hosted infrastructure', 'Urdu typesetting',
      ],
      sameAs: [
        'https://www.linkedin.com/in/mir-husain-ali-mohammed',
        'https://github.com/The-Tech-Boi',
      ],
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={site}>
<link rel="preload" href={headlineFont} as="font" type="font/woff2" crossorigin>
<meta name="author" content={name}>
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="me" href="https://github.com/The-Tech-Boi">
<link rel="me" href="https://www.linkedin.com/in/mir-husain-ali-mohammed">
<meta name="theme-color" content="#eef2f7">
<meta property="og:type" content="profile">
<meta property="og:site_name" content={name}>
<meta property="og:locale" content="en_US">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={site}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Mir Husain Ali, Dynamics 365 CE and data migration engineer. By day, client systems. After hours, my own tools.">
<meta property="profile:first_name" content="Mir Husain">
<meta property="profile:last_name" content="Ali">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
<style is:global>
  :root{
    --bg:rgb(238,242,247); --ink:rgb(16,20,28); --ink2:rgb(70,80,100); --acc:rgb(31,95,214); --panel:rgb(255,255,255); --line:rgb(205,212,224);
    --ease:cubic-bezier(.16,1,.3,1); --pop:cubic-bezier(.34,1.56,.64,1);
    --wrap:min(1180px, 100% - clamp(40px,8vw,120px));
  }
  *{box-sizing:border-box; margin:0}
  html{scrollbar-color:var(--acc) transparent; scroll-behavior:smooth}
  body{background:var(--bg); color:var(--ink); font-family:"Schibsted Grotesk",system-ui,sans-serif; font-size:18px; line-height:1.55; -webkit-font-smoothing:antialiased}
  ::selection{background:var(--acc); color:var(--bg)}
  :focus-visible{outline:2px solid var(--acc); outline-offset:3px; border-radius:6px}
  a{color:inherit; text-underline-offset:4px; text-decoration-thickness:1.5px}
  .mono{font-family:"JetBrains Mono",monospace; font-variant-numeric:tabular-nums}
  #sky{position:fixed; inset:0; width:100%; height:100%; pointer-events:none; z-index:0}
  main, header{position:relative; z-index:1}

  /* header + clock */
  header{position:fixed; top:0; left:0; right:0; z-index:5; display:flex; align-items:center; justify-content:space-between; gap:24px; padding:16px clamp(20px,4vw,60px); background:color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter:blur(10px)}
  header .me{font-weight:800; text-decoration:none; letter-spacing:-.01em}
  nav{display:flex; gap:clamp(14px,2vw,28px); font-size:15px; font-weight:500}
  nav a{text-decoration:none; color:var(--ink2)} nav a:hover{color:var(--ink)}
  .clock{display:flex; align-items:center; gap:12px; font-size:14px; color:var(--ink2)}
  .track{position:relative; width:140px; height:24px; cursor:pointer; touch-action:none}
  .track::before{content:""; position:absolute; left:0; right:0; top:50%; height:1.5px; background:var(--line)}
  .knob{position:absolute; top:4px; width:16px; height:16px; margin-left:-8px; border-radius:50%; background:var(--acc); transition:box-shadow .3s, background .3s}
  .knob.moon{background:transparent; box-shadow:inset -5px -1px 0 0 var(--acc)}
  .clock .t{min-width:46px; text-align:right}

  section, article{position:relative}
  .wrap{width:var(--wrap); margin-inline:auto}

  /* hero */
  .hero{min-height:100vh; display:flex; align-items:center; padding:110px 0 60px}
  .hero .wrap{display:grid; grid-template-columns:minmax(0,1fr); max-width:1180px}
  .hero .col{max-width:640px}
  h1{font-size:clamp(56px,8.2vw,112px); line-height:.92; letter-spacing:-.04em; font-weight:800}
  .role{font-size:clamp(19px,1.6vw,23px); line-height:1.45; color:var(--ink2); margin-top:22px; max-width:30ch}
  .role b{color:var(--ink); font-weight:700}
  .cta{display:flex; flex-wrap:wrap; gap:12px; margin-top:30px}
  .btn{display:inline-flex; align-items:center; gap:8px; height:48px; padding:0 22px; border-radius:12px; font-weight:700; font-size:16px; text-decoration:none; background:var(--ink); color:var(--bg); border:0; cursor:pointer; font-family:inherit; transition:transform .35s var(--pop), background .2s}
  .btn:hover{transform:translateY(-2px)}
  .btn:active{transform:scale(.97)}
  .btn.line{background:transparent; color:var(--ink); box-shadow:inset 0 0 0 1.5px var(--line)}
  .btn.line:hover{box-shadow:inset 0 0 0 1.5px var(--ink2)}
  .btn svg{width:14px; height:14px}
  .bench{margin-top:46px; max-width:560px}
  .bench h2{font-size:15px; font-weight:700; margin-bottom:10px}
  .bench dl{display:grid; grid-template-columns:auto 1fr; column-gap:18px; row-gap:9px; font-size:16px}
  .bench dt{color:var(--ink2); font-variant-numeric:tabular-nums; white-space:nowrap}
  .bench dt i{display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--acc); margin-right:8px; vertical-align:2px; animation:live 2.4s ease-in-out infinite}
  .bench dt i.off{background:var(--line); animation:none}
  @keyframes live{50%{opacity:.25}}

  /* shift headings */
  .shift{padding:clamp(90px,14vh,150px) 0 30px}
  .shift h2{font-size:clamp(40px,5vw,68px); line-height:1; letter-spacing:-.035em; font-weight:800}
  .shift p.lede{font-size:clamp(18px,1.4vw,21px); color:var(--ink2); margin-top:14px; max-width:46ch}
  .night h2{font-family:"Gloock",serif; font-weight:400; letter-spacing:-.01em; font-size:clamp(48px,6vw,84px)}

  /* a piece of work: text + its toy, composition varies per piece */
  .piece{display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(28px,5vw,80px); align-items:center; padding:clamp(56px,9vh,96px) 0}
  .piece.flip .txt{order:2}
  .piece h3{font-size:clamp(26px,2.4vw,34px); line-height:1.1; letter-spacing:-.02em; font-weight:800}
  .night .piece h3{font-family:"Gloock",serif; font-weight:400; font-size:clamp(32px,3vw,44px); letter-spacing:0}
  .piece p{margin-top:12px; max-width:44ch; color:var(--ink2)}
  .piece p strong{color:var(--ink); font-weight:700}
  .status{display:inline-flex; align-items:center; gap:8px; font-size:14px; font-weight:700; margin-top:16px; color:var(--ink)}
  .status i{width:8px; height:8px; border-radius:50%; background:var(--acc)}
  .status.done i{background:var(--ink2)}
  .links{display:flex; flex-wrap:wrap; gap:18px; margin-top:16px; font-weight:700; font-size:16px}
  .toy{background:var(--panel); border-radius:20px; padding:clamp(20px,2.2vw,30px); box-shadow:0 1px 0 var(--line), 0 24px 48px -30px rgba(10,20,40,.35); position:relative}
  .toy .bar .mono{white-space:nowrap; flex:none}
  .toy .bar{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:16px; font-size:14px; color:var(--ink2)}
  .small{all:unset; white-space:nowrap; cursor:pointer; font-weight:700; font-size:14px; color:var(--ink); padding:8px 14px; border-radius:10px; box-shadow:inset 0 0 0 1.5px var(--line); transition:box-shadow .2s, transform .3s var(--pop)}
  .small:hover{box-shadow:inset 0 0 0 1.5px var(--ink2)}
  .small:active{transform:scale(.95)}
  .small:focus-visible{outline:2px solid var(--acc); outline-offset:2px}
  .small.go{background:var(--ink); color:var(--bg); box-shadow:none}
  .small[disabled]{opacity:.45; cursor:default}

  /* migration toy */
  .lanes{display:grid; gap:12px}
  .lane{display:grid; grid-template-columns:52px 1fr; align-items:center; gap:12px; font-size:14px; color:var(--ink2)}
  .lane .rail{height:22px; border-radius:6px; background:repeating-linear-gradient(90deg, var(--line) 0 2px, transparent 2px 9px); position:relative; overflow:hidden; cursor:pointer}
  .lane .fill{position:absolute; inset:0; width:0; background:repeating-linear-gradient(90deg, var(--acc) 0 6px, transparent 6px 9px); border-radius:6px}
  .tally{display:flex; align-items:end; justify-content:space-between; margin-top:20px}
  .tally b{font-size:clamp(34px,3.2vw,46px); font-weight:800; letter-spacing:-.03em; font-variant-numeric:tabular-nums; line-height:1}
  .tally small{display:block; color:var(--ink2); font-size:14px; margin-top:4px}
  .stamp{font-weight:800; font-size:14px; letter-spacing:.04em; color:var(--acc); border:2px solid var(--acc); border-radius:8px; padding:6px 10px; transform:rotate(-6deg) scale(.6); opacity:0; transition:transform .45s var(--pop), opacity .2s}
  .stamp.on{transform:rotate(-6deg) scale(1); opacity:1}

  /* meter workshop toy */
  .scan{display:grid; grid-template-columns:150px 1fr; gap:18px; align-items:start}
  .barcode{height:96px; border-radius:10px; background:var(--bg); position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center}
  .barcode svg{width:118px; height:64px}
  .barcode .beam{position:absolute; left:8px; right:8px; height:2px; background:var(--acc); top:50%; opacity:0}
  .barcode.hit .beam{animation:beam .45s var(--ease)}
  @keyframes beam{0%{opacity:1; top:12%}100%{opacity:0; top:88%}}
  .batch{list-style:none; padding:0; display:grid; gap:6px; min-height:186px; align-content:start}
  .batch li{display:flex; justify-content:space-between; gap:10px; font-size:14px; padding:7px 10px; border-radius:8px; background:var(--bg); animation:slot .4s var(--pop)}
  .batch li.dup{background:transparent; box-shadow:inset 0 0 0 1.5px var(--acc); color:var(--ink)}
  .batch li span:last-child{color:var(--ink2)}
  .batch li .mono{white-space:nowrap}
  .batch .empty{color:var(--ink2); font-size:14px; background:none; animation:none; padding-left:0}
  @keyframes slot{from{transform:translateY(-8px); opacity:0}}
  .scanbar{display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; align-items:center}
  .scanbar .msg{font-size:14px; color:var(--ink2)}

  /* valet toy */
  .term{font-family:"JetBrains Mono",monospace; font-size:14px; line-height:1.7; min-height:220px}
  .term .who{color:var(--ink2)}
  .term .red{color:var(--acc); font-weight:600}
  .term > div{animation:slot .35s var(--ease)}
  .ask{margin:10px 0; padding:12px 14px; border-radius:12px; background:var(--bg); font-family:"Schibsted Grotesk",sans-serif; font-size:15px}
  .ask .row{display:flex; flex-wrap:wrap; gap:8px; margin-top:10px}
  .ask .small{white-space:normal}

  /* kanz pipeline toy */
  .pipe{display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; position:relative; margin-top:6px}
  .stn{border-radius:12px; padding:42px 10px 12px; text-align:center; font-size:14px; color:var(--ink2); background:var(--bg); transition:color .3s, box-shadow .3s}
  .stn.lit{color:var(--ink); box-shadow:inset 0 0 0 1.5px var(--acc)}
  .stn b{display:block; color:inherit; font-size:15px}
  .lyric{position:absolute; top:8px; left:0; width:calc((100% - 24px) / 4); display:flex; justify-content:center; transition:transform .7s var(--ease); pointer-events:none}
  .lyric span{background:var(--acc); color:var(--bg); font-size:12px; font-weight:700; padding:5px 10px; border-radius:6px; white-space:nowrap}
  .seg{display:inline-flex; border-radius:10px; box-shadow:inset 0 0 0 1.5px var(--line); padding:3px}
  .seg button{all:unset; white-space:nowrap; cursor:pointer; font-size:13px; font-weight:700; padding:7px 12px; border-radius:7px; color:var(--ink2)}
  .seg button[aria-pressed="true"]{background:var(--ink); color:var(--bg)}
  .seg button:focus-visible{outline:2px solid var(--acc)}

  /* wireguard toy */
  .tun{display:grid; grid-template-columns:auto 1fr; gap:24px; align-items:center}
  .switch{all:unset; cursor:pointer; width:72px; height:40px; border-radius:999px; background:var(--line); position:relative; transition:background .3s}
  .switch::after{content:""; position:absolute; top:5px; left:5px; width:30px; height:30px; border-radius:50%; background:var(--bg); transition:transform .4s var(--pop)}
  .switch[aria-checked="true"]{background:var(--acc)}
  .switch[aria-checked="true"]::after{transform:translateX(32px)}
  .switch:focus-visible{outline:2px solid var(--acc); outline-offset:3px}
  .tun .state{font-weight:700}
  .tun .state small{display:block; font-weight:400; color:var(--ink2); font-size:14px}
  .qr{width:132px; height:132px; margin-top:18px; border-radius:10px; background:var(--bg); padding:10px; opacity:.25; transition:opacity .4s}
  .qr.on{opacity:1}
  .qr svg{width:100%; height:100%; display:block}

  /* event lists: portal, wain and team toys share the batch row look */
  .feed{list-style:none; padding:0; display:grid; gap:6px; min-height:150px; align-content:start; margin-top:4px}
  .feed li{display:flex; justify-content:space-between; gap:12px; font-size:14px; padding:8px 10px; border-radius:8px; background:var(--bg); animation:slot .4s var(--pop)}
  .feed li span:first-child{white-space:nowrap}
  .feed li span:last-child{color:var(--ink2); text-align:right}
  .feed li.now{background:transparent; box-shadow:inset 0 0 0 1.5px var(--acc); color:var(--ink)}
  .feed .empty{color:var(--ink2); background:none; animation:none; padding-left:0}
  .pick{display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px}
  .pick button{all:unset; cursor:pointer; font-size:13px; font-weight:700; padding:7px 12px; border-radius:8px; color:var(--ink2); box-shadow:inset 0 0 0 1.5px var(--line)}
  .pick button[aria-pressed="true"]{background:var(--ink); color:var(--bg); box-shadow:none}
  .pick button:focus-visible{outline:2px solid var(--acc); outline-offset:2px}

  /* wain runbook toy */
  .steps{list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px}
  .steps li{border-radius:10px; padding:12px; background:var(--bg); font-size:14px; color:var(--ink2); transition:color .3s, box-shadow .3s}
  .steps li b{display:block; color:inherit; font-size:15px}
  .steps li.now{color:var(--ink); box-shadow:inset 0 0 0 1.5px var(--acc)}
  .steps li.ok{color:var(--ink)}
  .steps li.ok b::after{content:" ✓"}

  /* kanz studio toy */
  .sheet{background:var(--bg); border-radius:12px; padding:26px 22px; min-height:150px; display:flex; align-items:center; justify-content:center}
  .sheet p{font-family:"Gulzar",serif; font-size:clamp(28px,2.6vw,38px); line-height:2.1; color:var(--ink); margin:0; max-width:none; direction:rtl; text-align:center; min-height:2.1em}
  .sheet .caret{display:inline-block; width:2px; height:.9em; background:var(--acc); vertical-align:middle; margin-inline-start:2px; animation:blink 1s steps(1) infinite}
  @keyframes blink{50%{opacity:0}}
  .sheetbar{display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:14px}
  .sheetbar .msg{font-size:14px; color:var(--ink2)}

  /* dusk band */
  .dusk{min-height:120vh; display:flex; align-items:center}
  .dusk p{font-family:"Gloock",serif; font-size:clamp(38px,5vw,72px); line-height:1.12; max-width:16ch}

  /* contact */
  .contact{min-height:90vh; display:flex; align-items:center; padding:120px 0 80px}
  .contact h2{font-size:clamp(44px,6vw,84px); line-height:.98; letter-spacing:-.04em; font-weight:800; max-width:12ch}
  .contact p{color:var(--ink2); margin-top:16px; max-width:46ch}
  .foot{margin-top:56px; font-size:14px; color:var(--ink2); display:flex; flex-wrap:wrap; gap:8px 28px}

  @media (max-width:860px){
    nav a:not([href="#contact"]){display:none}
    .piece{grid-template-columns:minmax(0,1fr)} .piece.flip .txt{order:0}
    .scan{grid-template-columns:minmax(0,1fr)} .barcode{height:80px}
    .pipe{grid-template-columns:repeat(2,minmax(0,1fr))} .lyric{display:none}
    .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
    .track{width:90px}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    *,*::before,*::after{animation:none !important; transition:none !important}
  }
</style>
</head>
<body>
<canvas id="sky" aria-hidden="true"></canvas>

<header>
  <a class="me" href="#top">Mir Husain Ali</a>
  <nav aria-label="Sections"><a href="#day">Client work</a><a href="#night">Own tools</a><a href="#contact">Contact</a></nav>
  <div class="clock">
    <div class="track" id="track" role="slider" tabindex="0" aria-label="Time of day: drag to move through the page" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="knob" id="knob"></span></div>
    <span class="t mono" id="time">08:00</span>
  </div>
</header>

<main id="top">
  <section class="hero" data-sky="0">
    <div class="wrap"><div class="col">
      <h1>Mir Husain <br>Ali</h1>
      <p class="role"><b>Dynamics 365 CE</b> and data migration engineer at Async Solution. I build and run client systems by day, and my own tools after hours. Platform and DevOps too.</p>
      <div class="cta">
        <a class="btn" href={mailto}>Email Mir</a>
        <a class="btn line" href="https://github.com/The-Tech-Boi">GitHub</a>
        <a class="btn line" href="https://www.linkedin.com/in/mir-husain-ali-mohammed">LinkedIn</a>
      </div>
      <div class="bench">
        <h2>On the bench now</h2>
        <dl>
          <dt><i></i>Nov 2026</dt><dd>valet, rewritten in Rust: one Windows exe, now with its own logo.</dd>
          <dt><i></i>Nov 2026</dt><dd>Nama portal: Asset Relocation, Special Needs and three more services.</dd>
          <dt><i></i>Nov 2026</dt><dd>Kanz Studio: export to PDF and send pages to the Catalog.</dd>
          <dt><i></i>Nov 2026</dt><dd>Meter workshop app: barcode capture and duplicate checks.</dd>
          <dt><i class="off"></i>Jul 2026</dt><dd>Four-org Dynamics 365 CE migration went live.</dd>
        </dl>
      </div>
    </div></div>
  </section>

  <section class="shift" id="day" data-sky="0">
    <div class="wrap">
      <h2>Day shift</h2>
      <p class="lede">Client systems on Dynamics 365 CE, and the infrastructure under them. Big data, real users, and nothing allowed to go missing.</p>

      <article class="piece" data-sky="0">
        <div class="txt">
          <h3>Four orgs, one clean move</h3>
          <p>At Async Solution I merged the Dynamics 365 CE orgs of Oman's four electricity distribution companies into one for Nama Electricity Distribution: <strong>1.5M+ accounts</strong> and <strong>3.9M+ records</strong>, live in July 2026. I also look after the platform and the release pipelines around it.</p>
          <span class="status done"><i></i>Done, live since July 2026</span>
        </div>
        <div class="toy" id="mig">
          <div class="bar"><span>Click a lane to replay it</span><button class="small go" type="button" id="migGo">Replay the migration</button></div>
          <div class="lanes">
            <div class="lane"><span>Org 1</span><div class="rail" data-l="0"><div class="fill"></div></div></div>
            <div class="lane"><span>Org 2</span><div class="rail" data-l="1"><div class="fill"></div></div></div>
