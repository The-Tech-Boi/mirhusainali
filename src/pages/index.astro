<script is:inline>
(() => {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = s => document.querySelector(s), root = document.documentElement;

  /* ---------- sky: palettes blended by scroll ---------- */
  const SKY = [
    {bg:[238,242,247], ink:[16,20,28],   ink2:[70,80,100],  acc:[31,95,214],  panel:[255,255,255], line:[205,212,224]}, // day
    {bg:[233,158,118], ink:[28,18,30],   ink2:[74,44,52],   acc:[140,40,60],  panel:[246,196,166], line:[200,120,96]},  // dusk
    {bg:[11,20,48],    ink:[241,234,216],ink2:[170,179,204],acc:[226,176,74], panel:[20,32,70],    line:[44,60,104]},   // night
    {bg:[226,228,244], ink:[20,20,40],   ink2:[80,80,110],  acc:[196,90,120], panel:[255,255,255], line:[200,200,224]}  // dawn
  ];
  const mix = (a, b, t) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
  const sm = t => t * t * (3 - 2 * t);
  let marks = [], s = 0, H = innerHeight, W = innerWidth;
  function measure(){
    H = innerHeight; W = innerWidth;
    marks = [...document.querySelectorAll('[data-sky]')].map(el => { const r = el.getBoundingClientRect(); return {mid: r.top + scrollY + r.height / 2, sky: +el.dataset.sky}; }).sort((a, b) => a.mid - b.mid);
  }
  function skyAt(){
    const c = scrollY + H / 2;
    if (c <= marks[0].mid) return marks[0].sky;
    for (let i = 0; i < marks.length - 1; i++){
      const a = marks[i], b = marks[i + 1];
      if (c < b.mid) return a.sky + (b.sky - a.sky) * sm((c - a.mid) / (b.mid - a.mid));
    }
    return marks[marks.length - 1].sky;
  }
  function paint(){
    s = skyAt();
    const i = Math.min(2, Math.floor(s)), f = s - i, A = SKY[i], B = SKY[i + 1];
    const bg = mix(A.bg, B.bg, f);
    const lum = c => { const [r, g, b] = c.map(v => { v /= 255; return v <= .04045 ? v / 12.92 : ((v + .055) / 1.055) ** 2.4; }); return .2126 * r + .7152 * g + .0722 * b; };
    const light = lum(bg) > .18, src = (lum(A.bg) > lum(B.bg)) === light ? A : B;
    root.style.setProperty('--bg', 'rgb(' + bg.join(',') + ')');
    root.style.setProperty('--acc', 'rgb(' + mix(A.acc, B.acc, f).join(',') + ')');
    const cr = (x, y) => { const a = lum(x) + .05, b = lum(y) + .05; return Math.max(a, b) / Math.min(a, b); };
    for (const k of ['ink','line','panel']) root.style.setProperty('--' + k, 'rgb(' + src[k].join(',') + ')');
    root.style.setProperty('--ink2', 'rgb(' + (cr(src.ink2, bg) >= 4.5 ? src.ink2 : src.ink).join(',') + ')');
    clock();
  }

  /* ---------- clock in the header ---------- */
  const track = $('#track'), knob = $('#knob'), timeEl = $('#time');
  const MIN = [8 * 60, 18.5 * 60, 23 * 60, 29.75 * 60];
  function clock(){
    const max = document.documentElement.scrollHeight - H, p = max > 0 ? scrollY / max : 0;
    knob.style.left = (p * 100) + '%'; track.setAttribute('aria-valuenow', Math.round(p * 100));
    const i = Math.min(2, Math.floor(s)), m = (MIN[i] + (MIN[i + 1] - MIN[i]) * (s - i)) % 1440;
    timeEl.textContent = String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(Math.floor(m % 60)).padStart(2, '0');
    track.setAttribute('aria-valuetext', timeEl.textContent);
    knob.classList.toggle('moon', s > 1.4 && s < 2.6);
  }
  const seek = x => { const r = track.getBoundingClientRect(), p = Math.max(0, Math.min(1, (x - r.left) / r.width)); scrollTo({top: p * (document.documentElement.scrollHeight - H), behavior:'instant'}); };
  track.addEventListener('pointerdown', e => { track.setPointerCapture(e.pointerId); seek(e.clientX); track.onpointermove = ev => seek(ev.clientX); });
  track.addEventListener('pointerup', () => { track.onpointermove = null; });
  track.addEventListener('keydown', e => {
    const step = (document.documentElement.scrollHeight - H) / 20;
    if (e.key === 'ArrowRight' || e.key === 'ArrowUp'){ scrollBy({top: step}); e.preventDefault(); }
    if (e.key === 'ArrowLeft' || e.key === 'ArrowDown'){ scrollBy({top: -step}); e.preventDefault(); }
    if (e.key === 'Home'){ scrollTo({top: 0}); e.preventDefault(); }
    if (e.key === 'End'){ scrollTo({top: document.documentElement.scrollHeight}); e.preventDefault(); }
  });

  /* ---------- records by day, stars by night ---------- */
  const cv = $('#sky'), cx = cv.getContext('2d');
  let P = [], shoot = [];
  let seededW = 0;
  function size(){ const dpr = devicePixelRatio || 1; cv.width = W * dpr; cv.height = H * dpr; cx.setTransform(dpr, 0, 0, dpr, 0, 0); }
  function seed(){
    size(); seededW = W;
    const rows = W < 860 ? 12 : 22, per = W < 860 ? 8 : 10; P = [];
    for (let r = 0; r < rows; r++) for (let k = 0; k < per; k++)
      P.push({r, k, per, rows, sp: .012 + ((r * 7) % 5) * .006, d: Math.random(), sx: Math.random(), sy: Math.random() * .92, sz: .6 + Math.random() * 1.4, tw: 1 + Math.random() * 2, ph: Math.random() * 7, live: Math.random() < .08, gold: Math.random() < .12});
  }
  function dayPos(p, t){
    const narrow = W < 860, x0 = W * (narrow ? .06 : .55), x1 = W * (narrow ? .94 : .95), y0 = H * (narrow ? .62 : .2), y1 = H * (narrow ? .92 : .86);
    const u = ((p.k / p.per) + t * p.sp) % 1;
    return [x0 + u * (x1 - x0), y0 + (p.r / (p.rows - 1)) * (y1 - y0)];
  }
  function frame(now){
    const t = reduce ? 0 : now / 1000;
    cx.clearRect(0, 0, W, H);
    const m = sm(Math.max(0, Math.min(1, (s - .45) / 1.1)));
    const heroFade = W < 860 ? .16 : Math.max(.16, 1 - scrollY / (H * .9));
    const dawnFade = s > 2 ? 1 - (s - 2) * .85 : 1;
    const ink2 = root.style.getPropertyValue('--ink2'), acc = root.style.getPropertyValue('--acc');
    for (const p of P){
      const mp = Math.max(0, Math.min(1, m * 1.5 - p.d * .5)), e = sm(mp);
      const [dx, dy] = dayPos(p, t), nx = p.sx * W, ny = p.sy * H;
      const x = dx + (nx - dx) * e, y = dy + (ny - dy) * e - Math.sin(mp * Math.PI) * H * .12;
      const dayA = (p.live ? .9 : .5) * heroFade, nightA = (.55 + .45 * Math.sin(t * p.tw + p.ph)) * dawnFade;
      cx.globalAlpha = dayA + (nightA - dayA) * e;
      if (e < .6){
        cx.fillStyle = p.live ? acc : ink2;
        const w = 18 + (2 - 18) * e / .6, h = 4 + (2 - 4) * e / .6;
        cx.fillRect(x - w / 2, y - h / 2, w, h);
      } else {
        cx.fillStyle = p.gold ? 'rgb(226,176,74)' : 'rgb(241,234,216)';
        cx.beginPath(); cx.arc(x, y, p.sz, 0, 7); cx.fill();
      }
    }
    cx.globalAlpha = 1;
    shoot = shoot.filter(q => (q.t += .016) < 1);
    for (const q of shoot){
      const x = q.x + q.vx * q.t, y = q.y + q.vy * q.t, g = cx.createLinearGradient(x, y, x - q.vx * .25, y - q.vy * .25);
      g.addColorStop(0, 'rgba(241,234,216,' + (1 - q.t) + ')'); g.addColorStop(1, 'rgba(241,234,216,0)');
      cx.strokeStyle = g; cx.lineWidth = 2; cx.beginPath(); cx.moveTo(x, y); cx.lineTo(x - q.vx * .25, y - q.vy * .25); cx.stroke();
    }
    // With reduced motion the sky is still; redraw only when scrolling or resizing.
    if (!reduce) requestAnimationFrame(frame);
  }
  addEventListener('click', e => {
    if (reduce || s < 1.5 || s > 2.5 || e.target.closest('a,button,.toy,[role]')) return;
    shoot.push({x: e.clientX, y: e.clientY, vx: -260 - Math.random() * 140, vy: 160 + Math.random() * 80, t: 0});
  });

  /* ---------- migration toy ---------- */
  const fills = [...document.querySelectorAll('#mig .fill')], migN = $('#migN'), stamp = $('#migStamp');
  const SHARE = [.31, .27, .24, .18], TOTAL = 3900000;
  let done = [0, 0, 0, 0];
  function runLane(i, delay){
    return new Promise(res => {
      const start = performance.now() + delay, dur = reduce ? 0 : 1300 + i * 200;
      (function f(now){
        const p = dur ? Math.max(0, Math.min(1, (now - start) / dur)) : 1, e = 1 - Math.pow(1 - p, 3);
        fills[i].style.width = (e * 100) + '%'; done[i] = e;
        migN.textContent = Math.round(done.reduce((a, d, k) => a + d * SHARE[k], 0) * TOTAL).toLocaleString('en-US') + (done.every(d => d >= 1) ? '+' : '');
        if (p < 1) requestAnimationFrame(f); else res();
      })(performance.now());
    });
  }
  function migrate(){
    stamp.classList.remove('on'); done = [0, 0, 0, 0]; fills.forEach(f => f.style.width = 0);
    Promise.all(fills.map((_, i) => runLane(i, i * 260))).then(() => stamp.classList.add('on'));
  }
  $('#migGo').addEventListener('click', migrate);
  document.querySelectorAll('#mig .rail').forEach(r => r.addEventListener('click', () => { const i = +r.dataset.l; stamp.classList.remove('on'); runLane(i, 0).then(() => { if (done.every(d => d >= 1)) stamp.classList.add('on'); }); }));
  new IntersectionObserver((en, o) => { if (en[0].isIntersecting){ migrate(); o.disconnect(); } }, {threshold:.5}).observe($('#mig'));

  /* ---------- meter workshop toy ---------- */
  const POOL = ['MTR-0410-2281', 'MTR-0410-2282', 'MTR-0410-2290', 'MTR-0410-2304', 'MTR-0410-2317', 'MTR-0410-2333', 'MTR-0410-2341'];
  const batch = $('#batch'), msg = $('#scanMsg'), fileBtn = $('#fileBtn'), code = $('#code'), batchN = $('#batchN');
  let inBatch = [];
  function drawBars(){
    let x = 2, h = ''; while (x < 114){ const w = 1 + ((Math.random() * 3) | 0); h += `<rect x="${x}" y="0" width="${w}" height="64" fill="currentColor"/>`; x += w + 1 + ((Math.random() * 3) | 0); }
    $('#bars').innerHTML = h;
  }
  function scan(){
    if (inBatch.length >= 8){ msg.textContent = 'Batch is full. File it first.'; return; }
    const sn = POOL[(Math.random() * POOL.length) | 0];
    drawBars(); code.classList.remove('hit'); void code.offsetWidth; code.classList.add('hit');
    batch.querySelector('.empty')?.remove();
    const li = document.createElement('li');
    if (inBatch.includes(sn)){
      li.className = 'dup'; li.innerHTML = `<span class="mono">${sn}</span><span>duplicate, skipped</span>`;
      msg.textContent = 'Duplicate caught.';
      batch.prepend(li); setTimeout(() => li.remove(), 2200); return;
    }
    inBatch.push(sn); li.innerHTML = `<span class="mono">${sn}</span><span>checked</span>`;
    batch.prepend(li); while (batch.children.length > 6) batch.lastChild.remove();
    batchN.textContent = inBatch.length + ' / 8'; fileBtn.disabled = false; msg.textContent = 'Meter checked.';
  }
  $('#scanBtn').addEventListener('click', scan);
  addEventListener('keydown', e => { if (e.key.toLowerCase() === 's' && !e.target.closest('input,textarea,[contenteditable]') && !e.ctrlKey && !e.metaKey){ const r = code.getBoundingClientRect(); if (r.top < H && r.bottom > 0) scan(); } });
  fileBtn.addEventListener('click', () => {
    msg.textContent = `Batch of ${inBatch.length} filed in Dynamics 365.`;
    inBatch = []; batchN.textContent = '0 / 8'; fileBtn.disabled = true;
    batch.innerHTML = '<li class="empty">Filed. Scan a meter to start the next batch.</li>';
  });
  drawBars();

  /* ---------- valet toy ---------- */
  const term = $('#term');
  const line = (who, html) => { const d = document.createElement('div'); d.innerHTML = `<span class="who">${who}</span> ${html}`; term.appendChild(d); return d; };
  function valetStart(){
    term.innerHTML = '';
    line('assistant:', 'GET /api/accounts using <b>CRM API</b>');
    const a = document.createElement('div'); a.className = 'ask';
    a.innerHTML = 'Allow the assistant to use <b>CRM API</b> for this request?<div class="row"><button class="small go" type="button" data-v="allow">Allow</button><button class="small" type="button" data-v="deny">Deny</button><button class="small" type="button" data-v="peek">Ask for the password instead</button></div>';
    term.appendChild(a);
    a.addEventListener('click', e => {
      const v = e.target.dataset?.v; if (!v) return;
      if (v === 'peek'){ line('assistant:', 'just give me the password'); line('valet:', 'You can use it. You can\'t have it.'); return; }
      a.remove();
      if (v === 'deny'){ line('valet:', 'denied. Nothing was sent.'); return; }
      line('valet:', 'signed in, request sent');
      setTimeout(() => line('result:', '200 OK, Authorization: <span class="red">[REDACTED:CRM API]</span>'), reduce ? 0 : 450);
      setTimeout(() => line('audit:', 'one line written'), reduce ? 0 : 900);
    });
  }
  $('#vReset').addEventListener('click', valetStart); valetStart();

  /* ---------- shared bits for the newer toys ---------- */
  const later = (fn, ms) => setTimeout(fn, reduce ? 0 : ms);
  function picker(el){
    let k = el.querySelector('[aria-pressed="true"]').dataset.k;
    el.addEventListener('click', e => {
      const b = e.target.closest('button'); if (!b) return;
      el.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', x === b));
      k = b.dataset.k;
    });
    return () => k;
  }
  function feed(ul, rows){
    ul.innerHTML = '';
    rows.forEach(([a, b], i) => later(() => {
      ul.querySelector('.now')?.classList.remove('now');
      const li = document.createElement('li'); li.innerHTML = `<span>${a}</span><span>${b}</span>`;
      if (i === rows.length - 1) li.className = 'now';
      ul.appendChild(li);
    }, i * 450));
  }

  /* ---------- nama portal toy ---------- */
  const SERVICES = {
    asr: ['Asset relocation', true], smr: ['Self meter reading', false], sn: ['Special needs', true],
    comr: ['Compensation', true], ic: ['Initial connection', true],
  };
  const pKey = picker($('#pPick'));
  $('#pGo').addEventListener('click', () => {
    const [name, crm] = SERVICES[pKey()], ref = 'CAS-' + (10000 + ((Math.random() * 89999) | 0));
    feed($('#pFeed'), [
      ['Customer', name + ' request sent'],
      ['Portal', 'account and connection checked'],
      crm ? ['Dynamics 365', 'case ' + ref + ' opened for staff'] : ['Portal', 'reading saved, no case needed'],
    ]);
  });

  /* ---------- wain go-live toy ---------- */
  const wSteps = [...document.querySelectorAll('#wSteps li')], wMsg = $('#wMsg'), wGo = $('#wGo');
  wGo.addEventListener('click', () => {
    wGo.disabled = true; wSteps.forEach(li => li.className = ''); wMsg.textContent = 'Running the runbook…';
    wSteps.forEach((li, i) => {
      later(() => { li.className = 'now'; }, i * 520);
      later(() => { li.className = 'ok'; }, i * 520 + 480);
    });
    later(() => { wMsg.textContent = 'wain.online is live on the new setup.'; wGo.disabled = false; wGo.textContent = 'Run it again'; }, wSteps.length * 520);
  });

  /* ---------- team access toy ---------- */
  const tKey = picker($('#tPick'));
  $('#tGo').addEventListener('click', () => feed($('#tFeed'), tKey() === 'in' ? [
    ['Microsoft 365', 'signed in, MFA passed'],
    ['NetBird', 'connected, team servers reachable'],
    ['Vault', 'unlocked, 2 shared collections'],
  ] : [
    ['Microsoft 365', 'account removed when they left'],
    ['NetBird', 'no access'],
    ['Vault', 'no access, shared logins stay safe'],
  ]));

  /* ---------- kanz studio toy ---------- */
  const LINE = 'اردو اشاعت، ہر آلے پر', sLine = $('#sLine'), sMsg = $('#sMsg'), sGo = $('#sGo');
  let typing = 0;
  function typeLine(){
    clearInterval(typing); sMsg.textContent = '';
    if (reduce){ sLine.textContent = LINE; return; }
    let n = 0; sGo.disabled = true;
    typing = setInterval(() => {
      n++; sLine.innerHTML = LINE.slice(0, n) + '<span class="caret"></span>';
      if (n >= LINE.length){ clearInterval(typing); sGo.disabled = false; sGo.textContent = 'Type it again'; }
    }, 140);
  }
  sGo.addEventListener('click', typeLine);
  const sSeg = document.querySelector('.sheetbar .seg');
  sSeg.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; sSeg.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', x === b)); });
  $('#sExp').addEventListener('click', () => {
    if (!sLine.textContent) { sMsg.textContent = 'Type a line first.'; return; }
    const x = sSeg.querySelector('[aria-pressed="true"]').dataset.x;
    sMsg.textContent = x === 'Catalog' ? 'Page sent to the Kanz e Aza Catalog.' : x + ' ready, Nastaliq intact.';
  });

  /* ---------- kanz pipeline toy ---------- */
  const lyric = $('#lyric'), stns = [...document.querySelectorAll('.stn')];
  let script = 'English', running = false;
  document.querySelectorAll('.seg button').forEach(b => b.addEventListener('click', () => {
    document.querySelectorAll('.seg button').forEach(x => x.setAttribute('aria-pressed', x === b));
    script = b.dataset.s; lyric.firstElementChild.textContent = 'Lyric, ' + script;
  }));
  $('#kGo').addEventListener('click', async () => {
    if (running) return; running = true; stns.forEach(s => s.classList.remove('lit'));
    for (let i = 0; i < 4; i++){
      lyric.style.transform = `translateX(calc(${i} * (100% + 8px)))`; stns[i].classList.add('lit');
      await new Promise(r => setTimeout(r, reduce ? 0 : 750));
    }
    running = false;
  });

  /* ---------- wireguard toy ---------- */
  const tun = $('#tun'), qr = $('#qr');
  (function drawQR(){
    let h = ''; const fin = (x, y) => h += `<rect x="${x}" y="${y}" width="7" height="7" fill="currentColor"/><rect x="${x+1}" y="${y+1}" width="5" height="5" fill="var(--bg)"/><rect x="${x+2}" y="${y+2}" width="3" height="3" fill="currentColor"/>`;
    for (let y = 0; y < 25; y++) for (let x = 0; x < 25; x++){
      if ((x < 8 && y < 8) || (x > 16 && y < 8) || (x < 8 && y > 16)) continue;
      if (((x * 7 + y * 13 + x * y) % 5) < 2) h += `<rect x="${x}" y="${y}" width="1" height="1" fill="currentColor"/>`;
    }
    fin(0, 0); fin(18, 0); fin(0, 18); $('#qrSvg').innerHTML = h;
  })();
  tun.addEventListener('click', () => {
    const on = tun.getAttribute('aria-checked') !== 'true'; tun.setAttribute('aria-checked', on); qr.classList.toggle('on', on);
    $('#tunState').innerHTML = on ? 'Tunnel up<small>Scan the code to add a phone</small>' : 'Tunnel down<small>Flip it to bring a peer up</small>';
  });

  /* ---------- boot ---------- */
  addEventListener('scroll', paint, {passive:true});
  if (reduce) addEventListener('scroll', () => requestAnimationFrame(frame), {passive:true});
  // Mobile toolbars change only the height; keep the stars where they are then.
  addEventListener('resize', () => { measure(); if (W !== seededW) seed(); else size(); paint(); if (reduce) requestAnimationFrame(frame); });
  document.fonts.ready.then(() => { measure(); seed(); paint(); requestAnimationFrame(frame); });
})();
</script>
</body>
</html>
